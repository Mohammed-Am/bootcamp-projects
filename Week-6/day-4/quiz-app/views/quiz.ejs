<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= quiz ? quiz.title : 'Quiz' %></title>
  <link rel="stylesheet" href="/style.css">
</head>
<body>
  <div class="home-bg">
    <div class="container quiz-container">
      <% if (quiz) { %>
        <h1><%= quiz.title %> <span class="question-emoji">📝</span></h1>
        <form action="/quiz/<%= quiz.id %>/submit" method="POST">
          <% questions.forEach(function(q, idx) { %>
            <div class="progress-bar">
              <div class="progress" style="width: <%= (100 * (idx + 1) / questions.length) %>%;"></div>
            </div>
            <div class="question-block">
              <p><strong>Q<%= idx + 1 %>:</strong> <%= q.question_text %></p>
              <label><input type="radio" name="q<%= q.id %>" value="A" required> <%= q.option_a %></label><br>
              <label><input type="radio" name="q<%= q.id %>" value="B"> <%= q.option_b %></label><br>
              <label><input type="radio" name="q<%= q.id %>" value="C"> <%= q.option_c %></label><br>
              <label><input type="radio" name="q<%= q.id %>" value="D"> <%= q.option_d %></label><br>
            </div>
          <% }); %>
          <button type="submit" class="btn quiz-submit">Submit Answers</button>
        </form>
      <% } else { %>
        <h1>Quiz</h1>
        <p>The quiz will appear here soon!</p>
      <% } %>
    </div>
  </div>
</body>
</html>